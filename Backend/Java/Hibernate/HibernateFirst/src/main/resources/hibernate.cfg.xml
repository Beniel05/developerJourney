<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
		"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
		"http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>

	    <!-- Specifies the JDBC driver used to connect to MySQL. -->
	    <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
	
	    <!-- Specifies the MySQL database password. -->
	    <property name="hibernate.connection.password">root</property>
	
	    <!-- Specifies the JDBC URL of the MySQL database. -->
	    <property name="hibernate.connection.url">
	    		jdbc:mysql://localhost:3306/hibernate_demo_db
	    	</property>
	
	    <!-- Specifies the MySQL database username. -->
	    <property name="hibernate.connection.username">root</property>
	
	    <!-- Specifies the SQL dialect Hibernate should use for MySQL. -->
	    <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>
	
	    <!-- Automatically creates the database tables when Hibernate starts. -->
	    <!-- create / update. Update will work with the existing table without deleting -->
	    <property name="hibernate.hbm2ddl.auto">update</property>
	
	    <!-- Displays the SQL generated by Hibernate in the console. -->
	    <property name="hibernate.show_sql">true</property>
	
	    <!-- Formats the generated SQL for better readability. -->
	    <property name="hibernate.format_sql">true</property>
	
	    <!-- Registers the Student entity class with Hibernate. -->
	    <mapping class="com.beniel.model.Student"/>
	
	</session-factory>
</hibernate-configuration>
